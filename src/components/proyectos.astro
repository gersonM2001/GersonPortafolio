---
export interface Props {
  lang?: string;
  titulo: string;
  tituloEn?: string;
  descripcion: string;
  descripcionEn?: string;
  herramientas: string;
  imagenUrl: string;
  href: string;
}

const { lang = 'es', titulo, tituloEn, descripcion, descripcionEn, herramientas, imagenUrl, href } = Astro.props;
const isEn = lang === 'en';

const t = isEn ? (tituloEn ?? titulo) : titulo;
const d = isEn ? (descripcionEn ?? descripcion) : descripcion;
---

<a href={href} class="block h-full">
  <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-shadow duration-300 h-full">
    <img src={imagenUrl} alt={t} class="w-full h-48 object-cover rounded-lg shadow-lg mb-4" />

    <div class="text-center">
      <h3 class="text-2xl font-bold text-orange-900 mb-4">{t}</h3>
      <p class="text-lg text-gray-600 mb-4">{d}</p>
      <p class="font-semibold text-gray-800">{isEn ? 'Technologies used:' : 'Tecnologías utilizadas:'}</p>
      <p class="text-cyan-500">{herramientas}</p>
    </div>
  </div>
</a>