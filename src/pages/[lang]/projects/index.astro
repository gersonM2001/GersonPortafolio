---
// src/pages/[lang]/projects/index.astro
import Layout from "../../../layouts/Layout.astro";
import { ProyectosCartas } from "../../../content/ProyectosCartas";
import { Categorias } from "../../../content/categorias";
import type { Proyecto } from "../../../interfaces/interfaces";

export async function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const isEnglish = lang === "en";

// Agrupa los proyectos por categoría y oculta las categorías vacías
const grupos = Categorias
  .map((cat) => ({
    cat,
    proyectos: ProyectosCartas.filter((p: Proyecto) => p.categoria === cat.id),
  }))
  .filter((g) => g.proyectos.length > 0);
---

<Layout title={isEnglish ? "Projects" : "Proyectos"}>
  <div class="container mx-auto p-6">

    <!-- TÍTULO DE LA PÁGINA -->
    <h2 class="text-4xl font-semibold text-center mb-8">
      {isEnglish ? "Projects" : "Mis Proyectos"}
    </h2>

    <!-- SECCIONES POR CATEGORÍA -->
    {grupos.map(({ cat, proyectos }) => (
      <section id={cat.id} class="mb-12 scroll-mt-8">

        <h3 class="text-2xl font-bold text-orange-900 mb-6 pb-2 border-b-2 border-orange-200">
          {isEnglish ? cat.tituloEn : cat.titulo}
        </h3>

        <!-- GRID DE TARJETAS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
          {proyectos.map((proyecto: Proyecto) => (
            <a href={`/${lang}/projects/${isEnglish ? proyecto.slugEn ?? proyecto.slug : proyecto.slug}`}>
              <div class="bg-white shadow-lg rounded-lg overflow-hidden hover:shadow-2xl transition-shadow h-full">

                <img
                  src={proyecto.imagenUrl}
                  alt={isEnglish ? proyecto.tituloEn ?? proyecto.titulo : proyecto.titulo}
                  class="w-full h-48 object-cover"
                />

                <h4 class="text-xl font-semibold text-center text-gray-900 mt-4">
                  {isEnglish ? proyecto.tituloEn ?? proyecto.titulo : proyecto.titulo}
                </h4>

                <p class="text-gray-600 text-center px-4 py-2">
                  {isEnglish ? proyecto.descripcionEn ?? proyecto.descripcion : proyecto.descripcion}
                </p>

                <p class="text-sm text-gray-500 text-center mb-4 px-4">
                  <strong>{isEnglish ? "Tools" : "Herramientas"}:</strong> {proyecto.herramientas}
                </p>

              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>